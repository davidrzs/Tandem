{
  "name": "@tandem/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./trpc": "./src/trpc.ts"
  },
  "scripts": {
    "serve": "node --env-file-if-exists=../../.env --import tsx src/serve.ts",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/serve.ts",
    "test": "node --env-file-if-exists=../../.env --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.3.4",
    "@hocuspocus/server": "^4.7.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tandem/core": "workspace:*",
    "@tandem/db": "workspace:*",
    "@tandem/editor": "workspace:*",
    "@trpc/server": "^11.19.0",
    "better-auth": "^1.6.20",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fflate": "^0.8.3",
    "nodemailer": "^9.0.3",
    "tsx": "^4.23.15",
    "y-prosemirror": "^1.3.7",
    "yaml": "^2.9.1",
    "yjs": "^13.6.33",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "typescript": "^5.7.2"
  }
}
